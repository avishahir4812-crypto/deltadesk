# Local development (Postgres 13+)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ── Vercel one-shot deploy ──────────────────────────────────────────────
# Add any pooled Postgres connection string in Project → Settings →
# Environment Variables. DATABASE_URL, POSTGRES_URL and
# POSTGRES_URL_NON_POOLING are all accepted; SSL is auto-enabled for
# non-local hosts. Tables + demo content self-create on first request —
# no CLI step required. If no database is set, the terminal still runs;
# only persistence-backed features are disabled.
#
# Optional: secret for the /api/cron/brief automation endpoint
# CRON_SECRET=
